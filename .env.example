# AVGL GitHub App interactive private-repository access
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
AVGL_SESSION_SECRET=
AVGL_PUBLIC_ORIGIN=https://avgl.vercel.app

# Optional app-level automation only; not required for user-scoped private analysis
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Optional public GitHub API token for higher public-repo rate limits
GITHUB_TOKEN=

# Optional public-repository remote assistant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
