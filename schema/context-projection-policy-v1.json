{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avgl.dev/schema/context-projection-policy-v1.json",
  "title": "AVGL Context Projection Policy v1",
  "description": "Canonical AVGL-0296 policy contract. Projection selects/bounds evidenced IR content; it does not create truth, evidence, capability, authority, execution, or verification.",
  "type": "object",
  "required": ["version", "identity", "owner", "scope", "evidenceBoundary"],
  "properties": {
    "version": {
      "const": "1"
    },
    "identity": {
      "type": "object",
      "required": ["id", "revision"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "additionalProperties": false
    },
    "owner": {
      "type": "object",
      "required": ["reference"],
      "properties": {
        "reference": {
          "type": "object",
          "required": ["type", "id"],
          "properties": {
            "type": {
              "const": "governance_record"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["include", "deny"],
      "properties": {
        "include": {
          "$ref": "#/$defs/selectorSet"
        },
        "deny": {
          "$ref": "#/$defs/selectorSet"
        }
      },
      "additionalProperties": false
    },
    "evidenceBoundary": {
      "type": "object",
      "required": ["allowedStates", "inferredHandling"],
      "properties": {
        "allowedStates": {
          "type": "array",
          "items": {
            "enum": ["EXPLICIT", "OBSERVED"]
          },
          "uniqueItems": true
        },
        "inferredHandling": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": {
              "enum": ["preserve_as_inferred", "deny"]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "selectorSet": {
      "type": "object",
      "required": ["objects", "relations"],
      "properties": {
        "objects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "uniqueItems": true
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
