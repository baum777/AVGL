{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/analyze.mjs": {
      "maxDuration": 300
    },
    "api/repository.mjs": {
      "maxDuration": 60
    },
    "api/file.mjs": {
      "maxDuration": 20
    },
    "api/chat.mjs": {
      "maxDuration": 45
    },
    "api/workspace.mjs": {
      "maxDuration": 300
    },
    "api/github-app/install.mjs": {
      "maxDuration": 20
    },
    "api/github-app/callback.mjs": {
      "maxDuration": 20
    },
    "api/github-app/repos.mjs": {
      "maxDuration": 30
    },
    "api/github-app/disconnect.mjs": {
      "maxDuration": 10
    },
    "api/github-app/oauth-callback.mjs": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/web/index.html"
    },
    {
      "source": "/styles.css",
      "destination": "/web/styles.css"
    },
    {
      "source": "/app.js",
      "destination": "/web/app.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
